extend type Query {
    topProducts(first: Int = 5): [Product]
}

interface Producter {
    id: String!
}

type Manufacturer implements Producter @key(fields: "id") {
    id: String!
    name: String!
}

type Product @key(fields: "manufacturer { id } id") @key(fields: "upc") {
    id: String!
    manufacturer: Producter!
    upc: String!
    name: String!
    price: Int!
}
